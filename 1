        </a>

        <div onclick="openLocation()" class="btn-glass">
            <i class="fas fa-location-dot"></i> আমাদের শপের লোকেশন
        </div>

        <a href="https://instagram.com/next_zone3" target="_blank" class="btn-glass">
            <i class="fab fa-instagram"></i> ইনস্টাগ্রাম আইডি ভিজিট করুন
        </a>

        <a href="mailto:nextzone1service@gmail.com" class="btn-glass">
            <i class="fas fa-envelope"></i> ইমেইল করুন
        </a>
    </div>

    <!-- Location Modal -->
    <div id="location-modal">
        <div class="modal-content">
            <h2>📍 শপের লোকেশন</h2>
            <p>
                মার্কেটের নাম: আলহাস কাশেম কমপ্লেক্স<br><br>
                হাসপাতাল রোড, ফায়ার সার্ভিস অফিসের বিপরীতে,<br>
                পাতারহাট বন্দর  মেহেন্দিগঞ্জ, বরিশাল।<br><br>
                <b>নিচতলায়, দোকান নং: ১২ (Next Zone)</b><br><br>
                <small>ফায়ার সার্ভিসের কাছে এসে জিজ্ঞাসা করলেই দেখিয়ে দেবে।</small>
            </p>
            <button class="close-btn" onclick="closeLocation()">বন্ধ করুন</button>
        </div>
    </div>

    <!-- JavaScript -->
    <script>
        window.addEventListener('load', () => {
            setTimeout(() => {
                const splash = document.getElementById('splash-screen');
                const mainContent = document.getElementById('main-content');
                splash.classList.add('splash-hide');
                mainContent.classList.add('show-content');
                setTimeout(() => {
                    splash.style.display = 'none';
                }, 800);
            }, 2500);
        });

        function openLocation() {
            document.getElementById('location-modal').classList.add('active');
        }

        function closeLocation() {
            document.getElementById('location-modal').classList.remove('active');
        }

        document.getElementById('location-modal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeLocation();
            }
        });
    </script>
</body>
</html>
